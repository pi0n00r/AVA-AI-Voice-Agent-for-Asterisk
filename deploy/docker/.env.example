# AI-NOTICE:Schema-Version=0.1
# AI-NOTICE:License=AGPL-3.0-or-later
# AI-NOTICE:Project=Ava
# AI-NOTICE:Repository=https://github.com/pi0n00r/AVA-AI-Voice-Agent-for-Asterisk
# AI-NOTICE:Author=Gary Bajaj

# starter: bundled sandbox Asterisk. external-pbx: connect to your Asterisk.
COMPOSE_PROFILES=starter
AVA_IMAGE_TAG=maintained
AVA_ADMIN_PORT=3003
AVA_SIP_PORT=5060
AVA_BIND_IPV4=0.0.0.0
AVA_BIND_IPV6=::
AVA_IPV6_SUBNET=fd76:6176:6100::/64
HOST_PROJECT_ROOT=/opt/ava
TZ=UTC

# The installer generates all values marked GENERATED.
JWT_SECRET=GENERATED
LOCAL_WS_AUTH_TOKEN=GENERATED
ASTERISK_ARI_USERNAME=ava
ASTERISK_ARI_PASSWORD=GENERATED

# Starter profile SIP account and agent extension.
AVA_SIP_USERNAME=7001
AVA_SIP_PASSWORD=GENERATED
AVA_SIP_EXTENSION=7001
AVA_AGENT_EXTENSION=700

# External PBX profile. The installer ignores these while starter is active.
ASTERISK_HOST=starter_asterisk
ASTERISK_ARI_PORT=8088
ASTERISK_ARI_SCHEME=http
ASTERISK_ARI_SSL_VERIFY=true

# Local CPU model defaults. Models are downloaded once into ./models.
LOCAL_STT_BACKEND=vosk
LOCAL_STT_MODEL_PATH=/app/models/stt/vosk-model-small-en-us-0.15
LOCAL_LLM_MODEL_PATH=/app/models/llm/qwen2.5-1.5b-instruct-q4_k_m.gguf
LOCAL_LLM_CONTEXT=768
LOCAL_LLM_MAX_TOKENS=64
LOCAL_LLM_INFER_TIMEOUT_SEC=45
LOCAL_TTS_BACKEND=piper
LOCAL_TTS_MODEL_PATH=/app/models/tts/en_US-lessac-medium.onnx
LOCAL_WS_URL=ws://local_ai_server:8765

# Docker socket access. Check with: stat -c '%g' /var/run/docker.sock
DOCKER_GID=999
DOCKER_SOCK=/var/run/docker.sock

# Optional hosted providers, configured later in the WebUI or here.
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
GOOGLE_API_KEY=
ELEVENLABS_API_KEY=
FISH_AUDIO_API_KEY=
